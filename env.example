# Idioma de esta instancia (código ISO de 2 letras, ej: en, pt). Define
# el sufijo de las keys de KV (ver sufijoIdioma() en lib/kv.js) y el
# idioma en que se redacta el contenido generado (ver bloqueIdioma() en
# prompts/prompts.js). Default "es" si no está seteada -- no se agregó
# a REQUERIDAS en lib/validarEnv.js por eso mismo.
IDIOMA=es

# Versión de "herramientas disponibles" para el generador de "visual" --
# etiqueta que se guarda en cada marca de "sin cobertura" (ver
# necesitaHerramienta en prompts/prompts.js y VERSION_HERRAMIENTAS_VISUAL
# en lib/generar.js). Subila (ej: v0.1 -> v0.2) cuando agregues una
# herramienta nueva que resuelve casos que antes quedaban marcados --
# los temas con la versión vieja se reintentan solos la próxima vez que
# se pidan, y el frontend/panel admin puede usar esta misma etiqueta para
# decidir a qué temas mostrarles de nuevo el botón de "generar con IA".
# Default "v0.1" si no está seteada.
VERSION_HERRAMIENTAS_VISUAL=v0.1

# Auth entre generador-service-main y este service
# (header Authorization: Bearer <SERVICE_KEY>). Distinta a la del otro repo.
SERVICE_KEY=

# IA que arma el borrador (Claude/Fable), y que corrige "exam" (Fable)
ANTHROPIC_API_KEY=

# IA que corrige "practice"/"formula" (única), y fallback de
# corrección para "exam" si Fable falla
MISTRAL_API_KEY=

# Cloudflare KV -- namespaces separados por tipo (no un solo
# practice_JSON con prefijos: en la cuenta real, exam_JSON, formula_JSON,
# practice_JSON y visual_default son namespaces distintos, cada uno con
# su propio ID).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_NAMESPACE_ID_PRACTICE=
CLOUDFLARE_NAMESPACE_ID_EXAM=
CLOUDFLARE_NAMESPACE_ID_FORMULA=
# ID del namespace visual_default -- fórmula default del graficador
# interactivo (visual.html), pre-cargada por tema/materia.
CLOUDFLARE_NAMESPACE_ID_VISUAL=
# ID del namespace visual_later -- cuando la IA de tipo "visual" no puede
# armar una fórmula/comando que represente bien el tema (ver
# necesitaHerramienta en prompts/prompts.js), acá se anota qué herramienta
# haría falta en vez de guardar un default forzado. Solo hace falta si se
# va a pedir tipo "visual" (igual que CLOUDFLARE_NAMESPACE_ID_VISUAL).
CLOUDFLARE_NAMESPACE_ID_VISUAL_LATER=
# Token con permiso: Account > Workers KV Storage > Edit
CLOUDFLARE_API_TOKEN=
